#!/usr/bin/env bash
# tmux status segment: prints a VPN pill while a Pritunl profile is connected.
# Asks the local pritunl-service, the same API the Pritunl GUI uses.

sock=/var/run/pritunl.sock
[[ -S $sock ]] || exit 0

curl -s -m 1 --unix-socket "$sock" \
    -H "User-Agent: pritunl" \
    -H "Auth-Token: $(cat /var/run/pritunl.auth)" \
    http://unix/profile |
    grep -q '"status":"connected"' &&
    echo '#[fg=#181926 bg=#a6da95 bold] VPN #[default] '
